# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VALIDATE_SIGNATURE=true
META_REQUIRE_APP_SECRET=false

# PostgreSQL
# Opcional (tem precedência sobre DB_*):
# DATABASE_URL=postgresql://usuario:senha@host:5432/lavpop_chatbot
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lavpop_chatbot
DB_USER=postgres
DB_PASSWORD=postgres
DB_MIN_CONN=1
DB_MAX_CONN=5
DB_CONNECT_TIMEOUT=3

# App
APP_TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# Inatividade (encerramento automático de conversa)
# Tempo (em minutos) sem interação antes de encerrar conversa como "inativa"
INACTIVITY_TIMEOUT_MINUTES=15
# Intervalo (em segundos) entre as verificações de inatividade
INACTIVITY_CHECK_INTERVAL_SECONDS=60
