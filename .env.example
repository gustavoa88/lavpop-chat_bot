# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VALIDATE_SIGNATURE=true
META_REQUIRE_APP_SECRET=true

# PostgreSQL
# Opcional (tem precedência sobre DB_*):
# DATABASE_URL=postgresql://usuario:senha@host:5432/lavpop_chatbot
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lavpop_chatbot
DB_USER=postgres
DB_PASSWORD=postgres
DB_MIN_CONN=1
DB_MAX_CONN=5
DB_CONNECT_TIMEOUT=3

# App
APP_ENV=prod
APP_TZ=America/Sao_Paulo
LOG_LEVEL=INFO
APP_DEBUG_LOG_MODE=false
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
OBSERVABILITY_INTERNAL_ONLY=true
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
OPERATOR_PANEL_ENABLED=false
OPERATOR_PANEL_TOKEN=

# Inatividade (encerramento automático de conversa)
# Tempo (em minutos) sem interação antes de encerrar conversa como "inativa"
INACTIVITY_TIMEOUT_MINUTES=15
# Intervalo (em segundos) entre as verificações de inatividade
INACTIVITY_CHECK_INTERVAL_SECONDS=60
